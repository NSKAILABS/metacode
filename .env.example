# ──────────────────────────────────────────────────────────────────────
# MetaOpticsAI environment configuration
# Copy to .env and edit. Never commit .env.
# ──────────────────────────────────────────────────────────────────────

# ----- LLM provider -------------------------------------------------------
LLM_DEFAULT_PROVIDER=ollama

# Ollama (local)
LLM_OLLAMA_BASE_URL=http://localhost:11434
LLM_OLLAMA_MODEL=deepseek-r1:7b
LLM_OLLAMA_EMBED_MODEL=nomic-embed-text

# Groq (cloud, fast)
LLM_GROQ_MODEL=llama-3.1-70b-versatile
LLM_GROQ_API_KEY=

# Anthropic (cloud, frontier)
LLM_ANTHROPIC_API_KEY=
LLM_ANTHROPIC_MODEL=claude-opus-4-7

LLM_TEMPERATURE=0.1
LLM_NUM_PREDICT=1024

# ----- RCWA defaults ------------------------------------------------------
RCWA_HARMONICS=3
RCWA_RESOLUTION=64
RCWA_MINIBATCH_SIZE=20

# ----- Self-RAG workflow --------------------------------------------------
WORKFLOW_MAX_RAG_RETRIES=3
WORKFLOW_MAX_OPTIMIZE_ITERS=10
WORKFLOW_FOM_TARGET=0.85
WORKFLOW_DOC_GRADE_CUTOFF=0.6

# ----- MCP server ---------------------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_HEAVY_JOBS_ENABLED=true

# ----- TensorFlow noise ---------------------------------------------------
TF_CPP_MIN_LOG_LEVEL=3
